{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skylineslink:contract:wire-authenticate:2",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "minLength": 12,
      "maxLength": 12,
      "const": "authenticate"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "environmentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "expectedInstanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "productVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "contractVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1,
      "const": "2"
    },
    "coreManifestSha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "expectedAuthorityEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expectedGrantEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "clientNonce": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    }
  },
  "required": [
    "kind",
    "requestId",
    "environmentId",
    "profileId",
    "expectedInstanceId",
    "productVersion",
    "contractVersion",
    "coreManifestSha256",
    "expectedAuthorityEpoch",
    "expectedGrantEpoch",
    "clientNonce"
  ],
  "additionalProperties": false
}
