  "$defs": {
    "CityScope": {
      "type": "object",
      "properties": {
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 19
        },
        "cityId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "instanceId",
        "generation",
        "cityId"
      ],
      "additionalProperties": false
    },
    "RelativeEntityRef": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "version": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "required": [
        "index",
        "version"
      ],
      "additionalProperties": false
    },
    "NativeFloat": {
      "type": "number",
      "minimum": -3.4028234663852886e+38,
      "maximum": 3.4028234663852886e+38
    },
    "DirectRelations": {
      "type": "object",
      "properties": {
        "present": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "length": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "returned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "complete": {
          "type": "boolean"
        },
        "entries": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/RelativeEntityRef"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "exists": {
                "type": "boolean"
              },
              "optionMask": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "ref",
              "exists",
              "optionMask"
            ],
            "additionalProperties": false
          }
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 5,
              "maxLength": 14,
              "enum": [
                "MISSING_BUFFER",
                "READ_FAILED",
                "LIMIT"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "present",
        "length",
        "returned",
        "complete",
        "entries",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
