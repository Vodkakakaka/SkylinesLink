                "value": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 8,
                      "maxLength": 17,
                      "enum": [
                        "MISSING_COMPONENT",
                        "READ_FAILED",
                        "INVALID_VALUE",
                        "TOO_LONG",
                        "MISSING_VALUE"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "value",
                "reason"
              ],
              "additionalProperties": false
            },
            "nativeId": {
              "type": "object",
