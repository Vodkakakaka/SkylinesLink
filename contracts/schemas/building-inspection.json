                "min": {
                  "anyOf": [
                    {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "$ref": "#/$defs/NativeFloat"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "max": {
                  "anyOf": [
                    {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "$ref": "#/$defs/NativeFloat"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 11,
                      "maxLength": 17,
                      "enum": [
                        "MISSING_COMPONENT",
                        "READ_FAILED",
                        "INVALID_VALUE"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "coordinateSystem",
                "min",
                "max",
                "reason"
