                "reason": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 8,
                      "maxLength": 17,
                      "enum": [
                        "MISSING_COMPONENT",
                        "READ_FAILED",
                        "INVALID_VALUE",
                        "TOO_LONG",
                        "MISSING_VALUE"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "value",
                "reason"
              ],
              "additionalProperties": false
            },
            "lotCells": {
              "type": "object",
              "properties": {
                "width": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "depth": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 8,
                      "maxLength": 17,
                      "enum": [
                        "MISSING_COMPONENT",
                        "READ_FAILED",
                        "INVALID_VALUE",
                        "TOO_LONG",
                        "MISSING_VALUE"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "width",
                "depth",
                "reason"
              ],
              "additionalProperties": false
            },
            "baseConstructionCost": {
              "type": "object",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 8,
                      "maxLength": 17,
                      "enum": [
                        "MISSING_COMPONENT",
                        "READ_FAILED",
                        "INVALID_VALUE",
                        "TOO_LONG",
