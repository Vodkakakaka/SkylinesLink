                  ]
                },
                "reason": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 8,
                      "maxLength": 17,
                      "enum": [
                        "MISSING_COMPONENT",
                        "READ_FAILED",
                        "INVALID_VALUE",
                        "TOO_LONG",
                        "MISSING_VALUE"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "value",
                "reason"
              ],
              "additionalProperties": false
