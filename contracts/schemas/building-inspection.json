{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skylineslink:contract:building-inspection:1",
  "description": "One bounded native building observation. Relative entity references inherit scope; complete only describes each direct buffer prefix, never a transitive attachment graph. Lot cells and base prefab cost are metadata, not a footprint or placement quote. RoadEdge is a stored relation, not reachability or operation proof.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 11,
          "maxLength": 11,
          "const": "unavailable"
        },
        "reason": {
          "type": "string",
          "minLength": 4,
          "maxLength": 26,
          "enum": [
            "MENU",
            "LOADING",
            "SOURCE_UNAVAILABLE",
            "SCOPE_CHANGED",
            "CONTEXT_MISMATCH",
            "ENTITY_UNAVAILABLE",
            "NO_SELECTION",
            "SELECTION_CHANGED",
            "BUSY",
            "CAPTURE_FAILED",
            "STOPPED",
            "SELECTION_SOURCE_NOT_READY"
          ]
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 11,
          "maxLength": 11,
          "const": "unsupported"
        },
        "reason": {
          "type": "string",
          "minLength": 7,
          "maxLength": 17,
          "enum": [
            "PREVIEW",
            "DELETED",
            "NOT_BUILDING",
            "MISSING_TRANSFORM",
            "MISSING_PREFAB"
          ]
        },
        "scope": {
          "$ref": "#/$defs/CityScope"
        },
        "object": {
          "$ref": "#/$defs/RelativeEntityRef"
        }
      },
      "required": [
        "kind",
        "reason",
        "scope",
        "object"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 8,
          "maxLength": 8,
          "const": "observed"
        },
        "scope": {
          "$ref": "#/$defs/CityScope"
        },
        "object": {
          "$ref": "#/$defs/RelativeEntityRef"
        },
        "gameVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "source": {
          "type": "string",
          "minLength": 19,
          "maxLength": 19,
          "const": "native-ecs-building"
        },
        "selectionSource": {
          "type": "string",
          "minLength": 9,
          "maxLength": 12,
          "enum": [
            "selectedInfo",
            "entityRef"
          ]
        },
        "selectionSourceUpdatedFrame": {
          "type": "null",
          "description": "The native panel cache exposes no verified last-refreshed frame. Capture frames only describe this read."
        },
        "capture": {
          "type": "object",
          "properties": {
            "startedAtUnixMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "endedAtUnixMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "simulationFrameStart": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "simulationFrameEnd": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "required": [
            "startedAtUnixMs",
            "endedAtUnixMs",
            "simulationFrameStart",
            "simulationFrameEnd"
          ],
          "additionalProperties": false
        },
        "relationLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
