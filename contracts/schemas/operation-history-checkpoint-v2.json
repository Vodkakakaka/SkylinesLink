{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skylineslink:contract:operation-history-checkpoint:2",
  "description": "同一混合业务日志已确认前缀的完整Task元数据决定与原操作终态投影；不包含全部Operation阶段，不代表当前现场、授权、Plan或Native执行资格。来源、完整链、唯一性及SLHC完整性由消费边界核对。",
  "type": "object",
  "properties": {
    "source": {
      "$ref": "#/$defs/HistorySource"
    },
    "records": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/HistoryRecord"
      }
    },
    "taskRecords": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/TaskMetadataRow"
      }
    }
  },
  "required": [
    "source",
    "records",
    "taskRecords"
  ],
  "additionalProperties": false,
  "$defs": {
    "Identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "HistorySource": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2
        },
        "productId": {
          "type": "string",
          "minLength": 12,
          "maxLength": 12,
          "const": "skylineslink"
        },
        "environmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "storeId": {
          "$ref": "#/$defs/Identity"
        },
        "throughSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "producerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "producerInstanceId": {
          "$ref": "#/$defs/Identity"
        },
        "producerCoreManifestSha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "journalSchemaRevision": {
          "type": "integer",
          "minimum": 3,
          "maximum": 3
        },
        "publishedAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "selection": {
          "type": "string",
          "minLength": 42,
          "maxLength": 42,
          "const": "confirmedTaskMetadataAndOperationTerminals"
        },
        "throughBytes": {
          "type": "integer",
          "minimum": 45,
          "maximum": 2097152
        }
      },
      "required": [
        "formatVersion",
        "productId",
        "environmentId",
        "storeId",
        "throughSequence",
        "producerVersion",
        "producerInstanceId",
        "producerCoreManifestSha256",
        "journalSchemaRevision",
        "publishedAtUnixMs",
        "selection",
        "throughBytes"
      ],
      "additionalProperties": false
    },
    "HistoryContext": {
      "type": "object",
      "properties": {
        "instanceId": {
          "$ref": "#/$defs/Identity"
        },
        "generation": {
          "$ref": "#/$defs/Identity"
        },
        "gameState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 11,
          "enum": [
            "menu",
            "loading",
            "ready",
            "unavailable"
          ]
        },
        "cityId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "instanceId",
        "generation",
        "gameState",
        "cityId"
      ],
      "additionalProperties": false
    },
    "HistoryLoad": {
      "type": "object",
      "properties": {
        "physicalTaskState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15,
          "enum": [
            "notStarted",
            "running",
            "ranToCompletion",
            "faulted",
            "cancelled",
            "unknown"
          ],
          "description": "实际原生 Task 的物理状态；正常完成不等于 Load 返回 true 或目标 Ready。"
        },
        "loadReturnValue": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "实际 Task<bool> 正常完成时的原始返回值；未取得该值时为 null。"
        },
        "targetMatch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "enum": [
            "unknown",
            "different",
            "identityOnly",
            "exact"
          ]
        },
        "isObservationCurrent": {
          "type": "boolean",
          "description": "历史语义必须为false；不把已持久观察提升为当前世界事实。"
        },
        "correlatedTargetReady": {
          "type": "boolean"
        },
        "historicalCompletionProven": {
          "type": "boolean"
        },
        "observationEnd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "enum": [
            "open",
            "expired",
            "interrupted",
            "ownerStopped"
          ]
        },
        "observationContext": {
          "anyOf": [
            {
              "$ref": "#/$defs/HistoryContext"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "physicalTaskState",
        "loadReturnValue",
        "targetMatch",
        "isObservationCurrent",
        "correlatedTargetReady",
        "historicalCompletionProven",
        "observationEnd",
        "observationContext"
      ],
      "additionalProperties": false
    },
    "HistoryRecord": {
      "type": "object",
      "properties": {
        "terminalSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "submissionKey": {
          "type": "object",
          "properties": {
            "writeContextId": {
              "$ref": "#/$defs/Identity"
            },
            "requestId": {
              "$ref": "#/$defs/Identity"
            }
          },
          "required": [
            "writeContextId",
            "requestId"
          ],
          "additionalProperties": false
        },
        "operationId": {
          "$ref": "#/$defs/Identity"
        },
        "originInstanceId": {
          "$ref": "#/$defs/Identity"
        },
        "sourceContext": {
          "$ref": "#/$defs/HistoryContext"
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 9,
          "enum": [
            "succeeded",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "mayHaveApplied": {
          "type": "boolean"
        },
        "durability": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "const": "durable"
        },
        "load": {
          "$ref": "#/$defs/HistoryLoad"
        }
      },
      "required": [
        "terminalSequence",
        "submissionKey",
        "operationId",
        "originInstanceId",
        "sourceContext",
        "state",
        "mayHaveApplied",
        "durability",
        "load"
      ],
      "additionalProperties": false
    },
    "TaskMetadataRow": {
      "type": "object",
      "properties": {
        "sequence": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "environmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "entry": {
          "$ref": "#/$defs/TaskMetadataEntry"
        }
      },
      "required": [
        "sequence",
        "environmentId",
        "entry"
      ],
      "additionalProperties": false
    },
    "TaskMetadataEntry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 11,
              "maxLength": 11,
              "const": "taskCreated"
            },
            "taskId": {
              "$ref": "#/$defs/Identity"
            },
            "goalRevision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1
            },
            "controlVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1
            },
            "decision": {
              "$ref": "#/$defs/TaskDecision"
            },
            "goal": {
              "$ref": "#/$defs/TaskStatedIntent"
            }
          },
          "required": [
            "kind",
            "taskId",
            "goalRevision",
            "controlVersion",
            "decision",
            "goal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 15,
              "maxLength": 15,
              "const": "taskGoalRevised"
            },
            "taskId": {
              "$ref": "#/$defs/Identity"
            },
            "expectedGoalRevision": {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            "goalRevision": {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            "expectedControlVersion": {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            "decision": {
              "$ref": "#/$defs/TaskDecision"
            },
            "goal": {
              "$ref": "#/$defs/TaskStatedIntent"
            }
          },
          "required": [
            "kind",
            "taskId",
            "expectedGoalRevision",
            "goalRevision",
            "expectedControlVersion",
            "decision",
            "goal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 11,
              "maxLength": 11,
              "const": "taskStopped"
            },
            "taskId": {
              "$ref": "#/$defs/Identity"
            },
            "expectedControlVersion": {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            "controlVersion": {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            "decision": {
              "$ref": "#/$defs/TaskDecision"
            }
          },
          "required": [
            "kind",
            "taskId",
            "expectedControlVersion",
            "controlVersion",
            "decision"
          ],
          "additionalProperties": false
        }
      ]
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ContextSource": {
      "type": "object",
      "properties": {
        "instanceId": {
          "$ref": "#/$defs/Identity"
        },
        "generation": {
          "$ref": "#/$defs/Identity"
        },
        "gameState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 11,
          "enum": [
            "menu",
            "loading",
            "ready",
            "unavailable"
          ]
        },
        "cityId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "instanceId",
        "generation",
        "gameState",
        "cityId"
      ],
      "additionalProperties": false
    },
    "SubmissionKey": {
      "type": "object",
      "properties": {
        "writeContextId": {
          "$ref": "#/$defs/Identity"
        },
        "requestId": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "writeContextId",
        "requestId"
      ],
      "additionalProperties": false
    },
    "TaskDecisionActor": {
      "type": "object",
      "properties": {
        "profileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "profileInstanceId": {
          "type": "string",
          "minLength": 32,
          "maxLength": 32
        },
        "authorityEpoch": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "grantEpoch": {
          "$ref": "#/$defs/PositiveSafeInteger"
        }
      },
      "required": [
        "profileId",
        "profileInstanceId",
        "authorityEpoch",
        "grantEpoch"
      ],
      "additionalProperties": false
    },
    "TaskDecision": {
      "type": "object",
      "properties": {
        "submissionKey": {
          "$ref": "#/$defs/SubmissionKey"
        },
        "actor": {
          "$ref": "#/$defs/TaskDecisionActor"
        },
        "source": {
          "$ref": "#/$defs/ContextSource"
        },
        "commandHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "submissionKey",
        "actor",
        "source",
        "commandHash"
      ],
      "additionalProperties": false
    },
    "TaskStatedIntent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 12,
          "maxLength": 12,
          "const": "statedIntent"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requestText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "constraintsText": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "acceptanceText": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "kind",
        "title",
        "requestText",
        "constraintsText",
        "acceptanceText"
      ],
      "additionalProperties": false
    }
  }
}
