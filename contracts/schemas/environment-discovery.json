{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skylineslink:contract:environment-discovery:1",
  "type": "object",
  "properties": {
    "productId": {
      "type": "string",
      "minLength": 12,
      "maxLength": 12,
      "const": "skylineslink"
    },
    "environmentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "authorityEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "pipeName": {
      "type": "string",
      "minLength": 14,
      "maxLength": 120
    },
    "productVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "contractVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1,
      "const": "2"
    },
    "coreManifestSha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "processId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    }
  },
  "required": [
    "productId",
    "environmentId",
    "instanceId",
    "authorityEpoch",
    "pipeName",
    "productVersion",
    "contractVersion",
    "coreManifestSha256",
    "processId"
  ],
  "additionalProperties": false
}
