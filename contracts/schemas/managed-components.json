{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skylineslink:contract:managed-components:1",
  "type": "object",
  "properties": {
    "formatVersion": { "type": "integer", "minimum": 1, "maximum": 1 },
    "productId": { "type": "string", "const": "skylineslink", "minLength": 12, "maxLength": 12 },
    "components": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string", "minLength": 1, "maxLength": 64,
            "enum": [
              "mod/SkylinesLink.Contracts.dll", "mod/SkylinesLink.Application.dll",
              "mod/SkylinesLink.Infrastructure.dll", "mod/SkylinesLink.Mod.dll"
            ]
          },
          "moduleId": { "type": "string", "minLength": 32, "maxLength": 32, "pattern": "^[0-9a-f]{32}$" }
        },
        "required": ["path", "moduleId"],
        "additionalProperties": false
      }
    }
  },
  "required": ["formatVersion", "productId", "components"],
  "additionalProperties": false
}
