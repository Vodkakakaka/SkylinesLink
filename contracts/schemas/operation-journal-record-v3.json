{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skylineslink:contract:operation-journal-record:3",
  "description": "混合业务日志：保留原Load执行事实，并显式记录已接收的Task意图与停止决定；结构合法不表示授权、预算、Plan或Native执行资格。",
  "type": "object",
  "properties": {
    "sequence": {
      "$ref": "#/$defs/PositiveSafeInteger"
    },
    "environmentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "entry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 6,
              "maxLength": 6,
              "const": "header"
            },
            "storeId": {
              "$ref": "#/$defs/Identity"
            }
          },
          "required": [
            "kind",
            "storeId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 8,
              "maxLength": 8,
              "const": "accepted"
            },
            "operationId": {
              "$ref": "#/$defs/Identity"
            },
            "originInstanceId": {
              "$ref": "#/$defs/Identity"
            },
            "writeContextId": {
              "$ref": "#/$defs/Identity"
            },
            "requestId": {
              "$ref": "#/$defs/Identity"
            },
            "commandHash": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "profileId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "authorityEpoch": {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            "grantEpoch": {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            "source": {
              "$ref": "#/$defs/ContextSource"
            },
            "target": {
              "$ref": "#/$defs/LoadTarget"
            },
            "actorIdentity": {
              "$ref": "#/$defs/OperationActorIdentity"
            }
          },
          "required": [
            "kind",
            "operationId",
            "originInstanceId",
            "writeContextId",
            "requestId",
            "commandHash",
            "profileId",
            "authorityEpoch",
            "grantEpoch",
            "source",
            "target",
            "actorIdentity"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 12,
              "maxLength": 12,
              "const": "commitIntent"
            },
            "operationId": {
              "$ref": "#/$defs/Identity"
            },
            "target": {
              "$ref": "#/$defs/LoadTarget"
            },
            "nativeHost": {
              "type": "object",
              "properties": {
                "processId": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "creationTime": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                }
              },
              "required": [
                "processId",
                "creationTime"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "operationId",
            "target",
            "nativeHost"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 14,
              "maxLength": 14,
              "const": "nativeTerminal"
            },
            "operationId": {
              "$ref": "#/$defs/Identity"
            },
            "physicalTaskState": {
              "type": "string",
              "minLength": 1,
              "maxLength": 15,
              "enum": [
                "ranToCompletion",
                "faulted",
                "cancelled"
              ],
              "description": "实际原生 Task 的物理状态；正常完成不等于 Load 返回 true 或目标 Ready。"
            },
            "loadReturnValue": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "实际 Task<bool> 正常完成时的原始返回值；未取得该值时为 null。"
            },
            "boundTarget": {
              "anyOf": [
                {
                  "$ref": "#/$defs/LoadTarget"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "operationId",
            "physicalTaskState",
            "loadReturnValue",
            "boundTarget"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 8,
              "maxLength": 8,
              "const": "terminal"
            },
            "operationId": {
              "$ref": "#/$defs/Identity"
            },
            "state": {
              "type": "string",
              "minLength": 1,
              "maxLength": 9,
              "enum": [
                "succeeded",
                "failed",
                "cancelled",
                "unknown"
              ]
            },
            "mayHaveApplied": {
              "type": "boolean"
            },
            "submissionKnowledge": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12,
              "enum": [
                "notSubmitted",
                "submitted",
                "unknown"
              ]
            },
            "reasonCode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "load": {
              "$ref": "#/$defs/PersistedLoadFacts"
            }
          },
          "required": [
            "kind",
            "operationId",
            "state",
            "mayHaveApplied",
            "submissionKnowledge",
            "reasonCode",
            "load"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 11,
              "maxLength": 11,
              "const": "taskCreated"
            },
            "taskId": {
              "$ref": "#/$defs/Identity"
            },
            "goalRevision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1
            },
            "controlVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1
            },
            "decision": {
              "$ref": "#/$defs/TaskDecision"
            },
            "goal": {
              "$ref": "#/$defs/TaskStatedIntent"
            }
          },
          "required": [
            "kind",
            "taskId",
            "goalRevision",
            "controlVersion",
            "decision",
            "goal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 15,
              "maxLength": 15,
              "const": "taskGoalRevised"
            },
            "taskId": {
              "$ref": "#/$defs/Identity"
            },
            "expectedGoalRevision": {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            "goalRevision": {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            "expectedControlVersion": {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            "decision": {
              "$ref": "#/$defs/TaskDecision"
            },
            "goal": {
              "$ref": "#/$defs/TaskStatedIntent"
            }
          },
          "required": [
            "kind",
            "taskId",
            "expectedGoalRevision",
            "goalRevision",
            "expectedControlVersion",
            "decision",
            "goal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 11,
              "maxLength": 11,
              "const": "taskStopped"
            },
            "taskId": {
              "$ref": "#/$defs/Identity"
            },
            "expectedControlVersion": {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            "controlVersion": {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            "decision": {
              "$ref": "#/$defs/TaskDecision"
            }
          },
          "required": [
            "kind",
            "taskId",
            "expectedControlVersion",
            "controlVersion",
            "decision"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "sequence",
    "environmentId",
    "entry"
  ],
  "additionalProperties": false,
  "$defs": {
    "Identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ContextSource": {
      "type": "object",
      "properties": {
        "instanceId": {
          "$ref": "#/$defs/Identity"
        },
        "generation": {
          "$ref": "#/$defs/Identity"
        },
        "gameState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 11,
          "enum": [
            "menu",
            "loading",
            "ready",
            "unavailable"
          ]
        },
        "cityId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "instanceId",
        "generation",
        "gameState",
        "cityId"
      ],
      "additionalProperties": false
    },
    "LoadTarget": {
      "type": "object",
      "properties": {
        "providerId": {
          "$ref": "#/$defs/Identity"
        },
        "assetId": {
          "$ref": "#/$defs/Identity"
        },
        "contentVersion": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "providerId",
        "assetId",
        "contentVersion"
      ],
      "additionalProperties": false
    },
    "PersistedLoadFacts": {
      "description": "存储已知普通事实与实际观察上下文；不存储跨重启的 isObservationCurrent 承诺。",
      "type": "object",
      "properties": {
        "physicalTaskState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15,
          "enum": [
            "notStarted",
            "running",
            "ranToCompletion",
            "faulted",
            "cancelled",
            "unknown"
          ],
          "description": "实际原生 Task 的物理状态；正常完成不等于 Load 返回 true 或目标 Ready。"
        },
        "loadReturnValue": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "实际 Task<bool> 正常完成时的原始返回值；未取得该值时为 null。"
        },
        "targetMatch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "enum": [
            "unknown",
            "different",
            "identityOnly",
            "exact"
          ]
        },
        "correlatedTargetReady": {
          "type": "boolean"
        },
        "historicalCompletionProven": {
          "type": "boolean"
        },
        "observationEnd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "enum": [
            "open",
            "expired",
            "interrupted",
            "ownerStopped"
          ]
        },
        "observationContext": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContextSource"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "physicalTaskState",
        "loadReturnValue",
        "targetMatch",
        "correlatedTargetReady",
        "historicalCompletionProven",
        "observationEnd",
        "observationContext"
      ],
      "additionalProperties": false
    },
    "OperationActorIdentity": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 8,
              "maxLength": 8,
              "const": "recorded"
            },
            "profileInstanceId": {
              "type": "string",
              "minLength": 32,
              "maxLength": 32
            }
          },
          "required": [
            "kind",
            "profileInstanceId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 16,
              "maxLength": 16,
              "const": "legacyUnrecorded"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SubmissionKey": {
      "type": "object",
      "properties": {
        "writeContextId": {
          "$ref": "#/$defs/Identity"
        },
        "requestId": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "writeContextId",
        "requestId"
      ],
      "additionalProperties": false
    },
    "TaskDecisionActor": {
      "type": "object",
      "properties": {
        "profileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "profileInstanceId": {
          "type": "string",
          "minLength": 32,
          "maxLength": 32
        },
        "authorityEpoch": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "grantEpoch": {
          "$ref": "#/$defs/PositiveSafeInteger"
        }
      },
      "required": [
        "profileId",
        "profileInstanceId",
        "authorityEpoch",
        "grantEpoch"
      ],
      "additionalProperties": false
    },
    "TaskDecision": {
      "type": "object",
      "properties": {
        "submissionKey": {
          "$ref": "#/$defs/SubmissionKey"
        },
        "actor": {
          "$ref": "#/$defs/TaskDecisionActor"
        },
        "source": {
          "$ref": "#/$defs/ContextSource"
        },
        "commandHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "submissionKey",
        "actor",
        "source",
        "commandHash"
      ],
      "additionalProperties": false
    },
    "TaskStatedIntent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 12,
          "maxLength": 12,
          "const": "statedIntent"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requestText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "constraintsText": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "acceptanceText": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "kind",
        "title",
        "requestText",
        "constraintsText",
        "acceptanceText"
      ],
      "additionalProperties": false
    }
  }
}
