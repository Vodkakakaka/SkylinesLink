{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skylineslink:contract:authorization-snapshot:2",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "integer",
      "minimum": 2,
      "maximum": 2
    },
    "productId": {
      "type": "string",
      "minLength": 12,
      "maxLength": 12,
      "const": "skylineslink"
    },
    "environmentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "recordRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "authorityEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "profiles": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "profileInstanceId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32
          },
          "profileId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "grantEpoch": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "scopeMask": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "internalToken": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "externalHttpToken": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 64,
            "maxLength": 64
          }
        },
        "required": [
          "profileInstanceId",
          "profileId",
          "grantEpoch",
          "scopeMask",
          "internalToken",
          "externalHttpToken"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formatVersion",
    "productId",
    "environmentId",
    "recordRevision",
    "authorityEpoch",
    "profiles"
  ],
  "additionalProperties": false
}
