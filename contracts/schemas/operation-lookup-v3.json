{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skylineslink:contract:operation-lookup:3",
  "description": "活动事实与历史投影分开；历史未覆盖不表示不存在或可重发。",
  "type": "object",
  "properties": {
    "selector": {
      "$ref": "#/$defs/OperationSelector"
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 4,
              "maxLength": 4,
              "const": "live"
            },
            "instanceId": {
              "$ref": "#/$defs/Identity"
            },
            "lookup": {
              "$ref": "#/$defs/LiveLookup"
            }
          },
          "required": [
            "kind",
            "instanceId",
            "lookup"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 7,
              "maxLength": 7,
              "const": "history"
            },
            "access": {
              "type": "string",
              "minLength": 12,
              "maxLength": 15,
              "enum": [
                "activeAuthority",
                "offlineLease"
              ]
            },
            "source": {
              "$ref": "#/$defs/HistorySource"
            },
            "ageMs": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "integrity": {
              "type": "string",
              "minLength": 14,
              "maxLength": 14,
              "const": "sha256Verified"
            },
            "lookup": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "minLength": 5,
                      "maxLength": 5,
                      "const": "found"
                    },
                    "record": {
                      "$ref": "#/$defs/HistoryRecord"
                    }
                  },
                  "required": [
                    "kind",
                    "record"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "minLength": 11,
                      "maxLength": 11,
                      "const": "unavailable"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 19,
                      "maxLength": 19,
                      "const": "HISTORY_NOT_COVERED"
                    }
                  },
                  "required": [
                    "kind",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "kind",
            "access",
            "source",
            "ageMs",
            "integrity",
            "lookup"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "selector",
    "result"
  ],
  "additionalProperties": false,
  "$defs": {
    "Identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "HistorySource": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "productId": {
          "type": "string",
          "minLength": 12,
          "maxLength": 12,
          "const": "skylineslink"
        },
        "environmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "storeId": {
          "$ref": "#/$defs/Identity"
        },
        "throughSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "producerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "producerInstanceId": {
          "$ref": "#/$defs/Identity"
        },
        "producerCoreManifestSha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "journalSchemaRevision": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2
        },
        "publishedAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "selection": {
          "type": "string",
          "minLength": 19,
          "maxLength": 19,
          "const": "durableTerminalOnly"
        }
      },
      "required": [
        "formatVersion",
        "productId",
        "environmentId",
        "storeId",
        "throughSequence",
        "producerVersion",
        "producerInstanceId",
        "producerCoreManifestSha256",
        "journalSchemaRevision",
        "publishedAtUnixMs",
        "selection"
      ],
      "additionalProperties": false
    },
    "HistoryContext": {
      "type": "object",
      "properties": {
        "instanceId": {
          "$ref": "#/$defs/Identity"
        },
        "generation": {
          "$ref": "#/$defs/Identity"
        },
        "gameState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 11,
          "enum": [
            "menu",
            "loading",
            "ready",
            "unavailable"
          ]
        },
        "cityId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "instanceId",
        "generation",
        "gameState",
        "cityId"
      ],
      "additionalProperties": false
    },
    "HistoryLoad": {
      "type": "object",
      "properties": {
        "physicalTaskState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15,
          "enum": [
            "notStarted",
            "running",
            "ranToCompletion",
            "faulted",
            "cancelled",
            "unknown"
          ],
          "description": "实际原生 Task 的物理状态；正常完成不等于 Load 返回 true 或目标 Ready。"
        },
        "loadReturnValue": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "实际 Task<bool> 正常完成时的原始返回值；未取得该值时为 null。"
        },
        "targetMatch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "enum": [
            "unknown",
            "different",
            "identityOnly",
            "exact"
          ]
        },
        "isObservationCurrent": {
          "type": "boolean",
          "description": "历史语义必须为false；不把已持久观察提升为当前世界事实。"
        },
        "correlatedTargetReady": {
          "type": "boolean"
        },
        "historicalCompletionProven": {
          "type": "boolean"
        },
        "observationEnd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "enum": [
            "open",
            "expired",
            "interrupted",
            "ownerStopped"
          ]
        },
        "observationContext": {
          "anyOf": [
            {
              "$ref": "#/$defs/HistoryContext"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "physicalTaskState",
        "loadReturnValue",
        "targetMatch",
        "isObservationCurrent",
        "correlatedTargetReady",
        "historicalCompletionProven",
        "observationEnd",
        "observationContext"
      ],
      "additionalProperties": false
    },
    "HistoryRecord": {
      "type": "object",
      "properties": {
        "terminalSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "submissionKey": {
          "type": "object",
          "properties": {
            "writeContextId": {
              "$ref": "#/$defs/Identity"
            },
            "requestId": {
              "$ref": "#/$defs/Identity"
            }
          },
          "required": [
            "writeContextId",
            "requestId"
          ],
          "additionalProperties": false
        },
        "operationId": {
          "$ref": "#/$defs/Identity"
        },
        "originInstanceId": {
          "$ref": "#/$defs/Identity"
        },
        "sourceContext": {
          "$ref": "#/$defs/HistoryContext"
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 9,
          "enum": [
            "succeeded",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "mayHaveApplied": {
          "type": "boolean"
        },
        "durability": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "const": "durable"
        },
        "load": {
          "$ref": "#/$defs/HistoryLoad"
        }
      },
      "required": [
        "terminalSequence",
        "submissionKey",
        "operationId",
        "originInstanceId",
        "sourceContext",
        "state",
        "mayHaveApplied",
        "durability",
        "load"
      ],
      "additionalProperties": false
    },
    "OperationSelector": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "operationId",
              "minLength": 11,
              "maxLength": 11
            },
            "operationId": {
              "$ref": "#/$defs/Identity"
            }
          },
          "required": [
            "kind",
            "operationId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "submissionKey",
              "minLength": 13,
              "maxLength": 13
            },
            "submissionKey": {
              "type": "object",
              "properties": {
                "writeContextId": {
                  "$ref": "#/$defs/Identity"
                },
                "requestId": {
                  "$ref": "#/$defs/Identity"
                }
              },
              "required": [
                "writeContextId",
                "requestId"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "submissionKey"
          ],
          "additionalProperties": false
        }
      ]
    },
    "LiveLookup": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "found",
              "minLength": 5,
              "maxLength": 5
            },
            "operationId": {
              "$ref": "#/$defs/Identity"
            },
            "originInstanceId": {
              "$ref": "#/$defs/Identity"
            },
            "state": {
              "type": "string",
              "minLength": 1,
              "maxLength": 9,
              "enum": [
                "queued",
                "running",
                "waiting",
                "succeeded",
                "failed",
                "cancelled",
                "partial",
                "unknown"
              ]
            },
            "mayHaveApplied": {
              "type": "boolean"
            },
            "durability": {
              "type": "string",
              "minLength": 7,
              "maxLength": 11,
              "enum": [
                "durable",
                "volatile",
                "unavailable"
              ],
              "description": "已知执行及历史事实的可恢复性；不覆盖本次查询重算的当前世界匹配。"
            },
            "load": {
              "$ref": "#/$defs/LoadObservation"
            }
          },
          "required": [
            "kind",
            "operationId",
            "originInstanceId",
            "state",
            "mayHaveApplied",
            "durability"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pending",
              "minLength": 7,
              "maxLength": 7
            },
            "operationId": {
              "$ref": "#/$defs/Identity"
            },
            "originInstanceId": {
              "$ref": "#/$defs/Identity"
            },
            "durability": {
              "type": "string",
              "minLength": 7,
              "maxLength": 11,
              "enum": [
                "pending",
                "unavailable"
              ]
            }
          },
          "required": [
            "kind",
            "operationId",
            "originInstanceId",
            "durability"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "absent",
              "minLength": 6,
              "maxLength": 6
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "expired",
              "minLength": 7,
              "maxLength": 7
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unavailable",
              "minLength": 11,
              "maxLength": 11
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "enum": [
                "CONTEXT_UNKNOWN",
                "RECOVERY_INCOMPLETE",
                "JOURNAL_UNAVAILABLE",
                "JOURNAL_INCOMPATIBLE"
              ]
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "LoadObservation": {
      "type": "object",
      "properties": {
        "physicalTaskState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15,
          "enum": [
            "notStarted",
            "running",
            "ranToCompletion",
            "faulted",
            "cancelled",
            "unknown"
          ],
          "description": "实际原生 Task 的物理状态；正常完成不等于 Load 返回 true 或目标 Ready。"
        },
        "loadReturnValue": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "实际 Task<bool> 正常完成时的原始返回值；未取得该值时为 null。"
        },
        "targetMatch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "enum": [
            "unknown",
            "different",
            "identityOnly",
            "exact"
          ]
        },
        "isObservationCurrent": {
          "type": "boolean",
          "description": "由本次查询的实际实例和加载代次重算；历史记录不能恢复为当前匹配。"
        },
        "correlatedTargetReady": {
          "type": "boolean"
        },
        "historicalCompletionProven": {
          "type": "boolean"
        },
        "observationEnd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "enum": [
            "open",
            "expired",
            "interrupted",
            "ownerStopped"
          ]
        }
      },
      "required": [
        "physicalTaskState",
        "loadReturnValue",
        "targetMatch",
        "isObservationCurrent",
        "correlatedTargetReady",
        "historicalCompletionProven",
        "observationEnd"
      ],
      "additionalProperties": false
    }
  }
}
