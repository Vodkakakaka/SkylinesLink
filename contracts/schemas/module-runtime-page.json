{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skylineslink:contract:module-runtime-page:1",
  "description": "A bounded immutable runtime observation. Entries describe loader facts at capture time, not all installations, subscriptions, enabled modules or a health verdict.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 11,
          "maxLength": 11,
          "const": "unavailable"
        },
        "reason": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "enum": [
            "SOURCE_UNAVAILABLE",
            "BUSY",
            "REGISTRY_CHANGED",
            "CAPTURE_FAILED",
            "STOPPED",
            "SNAPSHOT_UNAVAILABLE",
            "PAGE_OUT_OF_RANGE"
          ]
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "const": "page"
        },
        "snapshot": {
          "$ref": "#/$defs/ModuleSnapshot"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "entries": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/ModuleRow"
          }
        },
        "returnedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "nextOffset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "snapshot",
        "offset",
        "entries",
        "returnedCount",
        "nextOffset"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "ModuleFieldIssue": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "minLength": 5,
          "maxLength": 15,
          "enum": [
            "entry",
            "asset",
            "assetGuid",
            "assemblyName",
            "assemblyVersion",
            "instanceCount",
            "databaseKind"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 7,
          "maxLength": 11,
          "enum": [
            "missing",
            "invalid",
            "tooLong",
            "unavailable"
          ]
        }
      },
      "required": [
        "field",
        "reason"
      ],
      "additionalProperties": false
    },
    "ModuleCoverage": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 10,
              "maxLength": 11,
              "enum": [
                "ENTRY_LIMIT",
                "TIME_LIMIT"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "visited": {
          "type": "integer",
          "minimum": 0,
          "maximum": 129
        },
        "observedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "totalCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "complete",
        "reason",
        "visited",
        "observedCount",
        "totalCount"
      ],
      "additionalProperties": false
    },
    "ModuleSnapshot": {
      "type": "object",
      "properties": {
        "snapshotId": {
          "type": "string",
          "minLength": 32,
          "maxLength": 32,
          "pattern": "^[0-9a-f]{32}$"
        },
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "captureStartedAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "captureEndedAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "gameVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "gameVersionIssue": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 7,
              "maxLength": 11,
              "enum": [
                "missing",
                "invalid",
                "tooLong",
                "unavailable"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "firstInitializationComplete": {
          "type": "boolean"
        },
        "restartRequired": {
          "type": "boolean"
        },
        "coverage": {
          "$ref": "#/$defs/ModuleCoverage"
        }
      },
      "required": [
        "snapshotId",
        "instanceId",
        "captureStartedAtUnixMs",
        "captureEndedAtUnixMs",
        "expiresAtUnixMs",
        "gameVersion",
        "gameVersionIssue",
        "firstInitializationComplete",
        "restartRequired",
        "coverage"
      ],
      "additionalProperties": false
    },
    "ModuleRow": {
      "type": "object",
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "assetGuid": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 32,
              "maxLength": 32,
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "isMod": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "loaderStateCode": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "loaderState": {
          "type": "string",
          "minLength": 6,
          "maxLength": 26,
          "enum": [
            "unknown",
            "loaded",
            "disposed",
            "notModWarning",
            "notUniqueWarning",
            "generalError",
            "missingDependenciesError",
            "loadAssemblyError",
            "loadAssemblyReferenceError",
            "unrecognized",
            "unavailable"
          ]
        },
        "assemblyPresent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "assemblyName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "assemblyVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "instanceCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "hasLoadError": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "databaseKind": {
          "type": "string",
          "minLength": 4,
          "maxLength": 11,
          "enum": [
            "user",
            "paradoxMods",
            "game",
            "other",
            "unknown"
          ]
        },
        "fieldIssues": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/ModuleFieldIssue"
          }
        }
      },
      "required": [
        "ordinal",
        "assetGuid",
        "isMod",
        "loaderStateCode",
        "loaderState",
        "assemblyPresent",
        "assemblyName",
        "assemblyVersion",
        "instanceCount",
        "hasLoadError",
        "databaseKind",
        "fieldIssues"
      ],
      "additionalProperties": false
    }
  }
}
