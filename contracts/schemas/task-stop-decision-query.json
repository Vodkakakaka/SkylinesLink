{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skylineslink:contract:task-stop-decision-query:1",
  "description": "同任务与原预期控制版本选择停止决定；source省略由消费者解释为live，不自动回退history。",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expectedControlVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740990
    },
    "source": {
      "type": "string",
      "minLength": 4,
      "maxLength": 7,
      "enum": [
        "live",
        "history"
      ],
      "description": "缺省live；只有显式history消费已确认出版物。"
    }
  },
  "required": [
    "taskId",
    "expectedControlVersion"
  ],
  "additionalProperties": false
}
