{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skylineslink:contract:wire-authenticated:2",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "minLength": 13,
      "maxLength": 13,
      "const": "authenticated"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "environmentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "productVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "contractVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1,
      "const": "2"
    },
    "coreManifestSha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "authorityEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "grantEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "kind",
    "requestId",
    "environmentId",
    "profileId",
    "instanceId",
    "productVersion",
    "contractVersion",
    "coreManifestSha256",
    "authorityEpoch",
    "grantEpoch"
  ],
  "additionalProperties": false
}
