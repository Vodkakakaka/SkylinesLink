{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skylineslink:contract:native-history-request:2",
  "description": "短命只读混合历史查询；三个expected字段由读取边界核对同时为null或同时给出，不从旧身份猜测profile incarnation。文件路径由受控边界确定；无覆盖不表示absent或expired。",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "integer",
      "minimum": 2,
      "maximum": 2
    },
    "environmentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "expectedAuthorityEpoch": {
      "anyOf": [
        {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        {
          "type": "null"
        }
      ]
    },
    "expectedGrantEpoch": {
      "anyOf": [
        {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        {
          "type": "null"
        }
      ]
    },
    "expectedProfileInstanceId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 32,
          "maxLength": 32
        },
        {
          "type": "null"
        }
      ]
    },
    "query": {
      "$ref": "#/$defs/NativeHistoryQuery"
    }
  },
  "required": [
    "formatVersion",
    "environmentId",
    "profileId",
    "expectedAuthorityEpoch",
    "expectedGrantEpoch",
    "expectedProfileInstanceId",
    "query"
  ],
  "additionalProperties": false,
  "$defs": {
    "Identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "OperationSelector": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "operationId",
              "minLength": 11,
              "maxLength": 11
            },
            "operationId": {
              "$ref": "#/$defs/Identity"
            }
          },
          "required": [
            "kind",
            "operationId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "submissionKey",
              "minLength": 13,
              "maxLength": 13
            },
            "submissionKey": {
              "type": "object",
              "properties": {
                "writeContextId": {
                  "$ref": "#/$defs/Identity"
                },
                "requestId": {
                  "$ref": "#/$defs/Identity"
                }
              },
              "required": [
                "writeContextId",
                "requestId"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "submissionKey"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SubmissionKey": {
      "type": "object",
      "properties": {
        "writeContextId": {
          "$ref": "#/$defs/Identity"
        },
        "requestId": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "writeContextId",
        "requestId"
      ],
      "additionalProperties": false
    },
    "NativeHistoryQuery": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 9,
              "maxLength": 9,
              "const": "operation"
            },
            "selector": {
              "$ref": "#/$defs/OperationSelector"
            }
          },
          "required": [
            "kind",
            "selector"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 4,
              "maxLength": 4,
              "const": "task"
            },
            "taskId": {
              "$ref": "#/$defs/Identity"
            }
          },
          "required": [
            "kind",
            "taskId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 12,
              "maxLength": 12,
              "const": "taskDecision"
            },
            "submissionKey": {
              "$ref": "#/$defs/SubmissionKey"
            }
          },
          "required": [
            "kind",
            "submissionKey"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 8,
              "maxLength": 8,
              "const": "taskGoal"
            },
            "taskId": {
              "$ref": "#/$defs/Identity"
            },
            "goalRevision": {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            "section": {
              "type": "string",
              "minLength": 5,
              "maxLength": 15,
              "enum": [
                "title",
                "requestText",
                "constraintsText",
                "acceptanceText"
              ]
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            }
          },
          "required": [
            "kind",
            "taskId",
            "goalRevision",
            "section",
            "offset",
            "limit"
          ],
          "additionalProperties": false
        }
      ],
      "description": "只查询已确认历史；文本offset与limit按Unicode标量，列表按项且limit不得超过4、offset不得超过16，由读取边界按section核对。"
    }
  }
}
