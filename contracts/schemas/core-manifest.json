{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skylineslink:contract:core-manifest:1",
  "type": "object",
  "properties": {
    "productId": {
      "type": "string",
      "const": "skylineslink",
      "minLength": 12,
      "maxLength": 12
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "sourceCommit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "contractVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/CoreFile"
      }
    }
  },
  "required": [
    "productId",
    "version",
    "sourceCommit",
    "contractVersion",
    "files"
  ],
  "additionalProperties": false,
  "$defs": {
    "CoreFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
