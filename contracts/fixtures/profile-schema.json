{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skylineslink:contract:profile-fixture:1",
  "type": "object",
  "properties": {
    "label": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 3
    },
    "amount": {
      "type": "string",
      "minLength": 4,
      "maxLength": 10
    },
    "count": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "distance": {
      "type": "number",
      "minimum": -100,
      "maximum": 100
    },
    "enabled": {
      "type": "boolean"
    },
    "tags": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2,
        "enum": [
          "中",
          "ok"
        ]
      }
    },
    "choice": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "point",
              "minLength": 5,
              "maxLength": 5
            },
            "point": {
              "$ref": "#/$defs/Point"
            }
          },
          "required": [
            "kind",
            "point"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none",
              "minLength": 4,
              "maxLength": 4
            },
            "note": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 0,
              "maxLength": 8
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "optionalNumber": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -1,
      "maximum": 1
    },
    "optionalChild": {
      "anyOf": [
        {
          "$ref": "#/$defs/Point"
        },
        {
          "type": "null"
        }
      ]
    },
    "defaulted": {
      "type": "boolean",
      "default": true
    },
    "matrix": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": {
        "type": "array",
        "minItems": 0,
        "maxItems": 2,
        "items": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        }
      }
    },
    "enumIntersection": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ok",
        "no"
      ],
      "minLength": 1,
      "maxLength": 2
    },
    "constantIntersection": {
      "type": [
        "string",
        "null"
      ],
      "const": "ok",
      "minLength": 1,
      "maxLength": 2
    },
    "enumNullable": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "ok",
            "no"
          ],
          "minLength": 1,
          "maxLength": 2
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "amount",
    "count",
    "distance",
    "enabled",
    "tags",
    "choice"
  ],
  "additionalProperties": false,
  "$defs": {
    "Point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "mode": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "fast",
                  "minLength": 4,
                  "maxLength": 4
                },
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                }
              },
              "required": [
                "kind",
                "count"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "slow",
                  "minLength": 4,
                  "maxLength": 4
                },
                "note": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 16
                }
              },
              "required": [
                "kind",
                "note"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "x",
        "y",
        "mode"
      ],
      "additionalProperties": false
    }
  }
}
