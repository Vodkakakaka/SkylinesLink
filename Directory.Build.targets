<Project>
  <!-- SDK upgrades must not silently change the locked analyzer/compiler packages.
       These are product build dependencies, independent of the installed SDK. -->
  <ItemGroup>
    <KnownILLinkPack Update="Microsoft.NET.ILLink.Tasks">
      <ILLinkPackVersion Condition="'%(KnownILLinkPack.TargetFramework)' == 'net10.0'">10.0.14</ILLinkPackVersion>
    </KnownILLinkPack>
    <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler">
      <ILCompilerPackVersion Condition="'%(KnownILCompilerPack.TargetFramework)' == 'net10.0'">10.0.14</ILCompilerPackVersion>
    </KnownILCompilerPack>
  </ItemGroup>
</Project>
