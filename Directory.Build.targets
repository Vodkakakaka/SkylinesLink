<Project>
  <!-- SDK upgrades must not silently change the locked analyzer/compiler packages.
       These are product build dependencies, independent of the installed SDK. -->
  <ItemGroup>
    <KnownILLinkPack Update="@(KnownILLinkPack->WithMetadataValue('TargetFramework', 'net10.0'))">
      <ILLinkPackVersion>10.0.14</ILLinkPackVersion>
    </KnownILLinkPack>
    <KnownILCompilerPack Update="@(KnownILCompilerPack->WithMetadataValue('TargetFramework', 'net10.0'))">
      <ILCompilerPackVersion>10.0.14</ILCompilerPackVersion>
    </KnownILCompilerPack>
  </ItemGroup>
</Project>
